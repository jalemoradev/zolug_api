# === App ===
PORT=7010
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:7020

# === Base de datos (Neon Postgres) ===
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=neondb
DB_SSL=true

# === JWT (RS256, claves PEM inline en el env) ===
# PEM en una sola línea con saltos como \n literales, entre comillas dobles.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
JWT_EXPIRES_IN=1d
AUTH_COOKIE_NAME=zolug-auth

# === Hashing ===
BCRYPT_SALT_ROUNDS=12
