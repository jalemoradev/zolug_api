# === App ===
PORT=7010
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:7020

# === Base de datos (Neon Postgres) ===
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=neondb
DB_SSL=true

# === JWT (RS256, claves en keys/) ===
JWT_PRIVATE_KEY_PATH=keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt-public.pem
JWT_EXPIRES_IN=1d
AUTH_COOKIE_NAME=zolug-auth

# === Hashing ===
BCRYPT_SALT_ROUNDS=12
